          "label": "正确性判断",
          "problems": [
            {
              "id": 2,
              "statement": "一个骰子显示顶部 1、前面 6，这是否可能？",
              "answer": "否",
              "solutions": [
                {
                  "method": "对面判断",
                  "steps": [
                    "标准骰子对面和为 7。",
                    "1 的对面是 6。",
                    "顶部是 1 → 前面不能是 6。"
                  ]
                }
              ],
              "hasAnimation": false,
              "has3D": false
            }
          ]
        }
