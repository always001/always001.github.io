          "subLevelId": 1,
          "label": "基础认识",
          "problems": [
            {
              "id": 1,
              "statement": "骰子顶部是 1，前面是 2，右侧是 3，问左侧是多少？",
              "answer": "4",
              "solutions": [
                {
                  "method": "观察法",
                  "steps": [
                    "标准骰子对面和为 7。",
                    "右侧是 3 → 左侧是 4。"
                  ]
                }
              ],
              "hasAnimation": true,
              "has3D": false,
              "initialTop": 1,
              "initialFront": 2,
              "initialRight": 3,
              "path": ["右", "前"]
            }
          ]
        }
      ]
    },

    {
