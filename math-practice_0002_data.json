          "label": "空间方位",
          "problems": [
            {
              "id": 5,
              "statement": "骰子顶部是 2，右侧是 6，问前面是多少？",
              "answer": "3",
              "solutions": [
                {
                  "method": "旋转推理",
                  "steps": [
                    "顶部 2 → 底部 5。",
                    "右侧 6 → 左侧 1。",
                    "剩余前后为 3 和 4。",
                    "根据标准布局 → 前面是 3。"
                  ]
                }
              ],
              "hasAnimation": true,
              "initialTop": 2,
              "initialFront": 3,
              "initialRight": 6
            }
          ]
        }
      ]
