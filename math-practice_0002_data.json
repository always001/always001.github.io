              "answer": "1",
              "solutions": [
                {
                  "method": "对面和为 7",
                  "steps": [
                    "左侧 4 → 右侧 3。",
                    "右侧 2 → 左侧 5。",
                    "综合推理 → 顶部为 1。"
                  ]
